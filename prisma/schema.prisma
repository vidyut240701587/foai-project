generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  name              String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  departmentId      String?
  semesterId        String?
  year              Int?
  dailyStudyHours   Int?
  onboardingComplete Boolean      @default(false)
  profile           Profile?
  exams             Exam[]
  questionPapers    QuestionPaper[]
  studyPlans       StudyPlan[]
  quizAttempts     QuizAttempt[]
  topicProgress    TopicProgress[]
  subjects          UserSubject[]
  bookmarks         Bookmark[]
  notifications     Notification[]
  chatMessages      ChatMessage[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  department       String?
  semester         String?
  preferredHours   Int?
  examDates        Json?
  selectedSubjects Json?
  preparationLevel String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String?
  semesters   Semester[]
  subjects    Subject[]
  regulations Regulation[]
  createdAt   DateTime   @default(now())

  @@index([code])
}

model Regulation {
  id          String       @id @default(cuid())
  code        String       @unique
  year        Int
  departments Department[]
  semesters   Semester[]
  subjects    Subject[]
  createdAt   DateTime     @default(now())
}

model Semester {
  id           String     @id @default(cuid())
  name         String
  number       Int?
  departmentId String
  regulationId String?
  department   Department @relation(fields: [departmentId], references: [id])
  regulation   Regulation? @relation(fields: [regulationId], references: [id])
  subjects     Subject[]

  @@index([departmentId, number])
}

model Subject {
  id             String            @id @default(cuid())
  externalId     String?           @unique
  code           String
  name           String
  description    String?
  departmentId   String?
  semesterId     String?
  regulationId   String?
  department     Department?       @relation(fields: [departmentId], references: [id])
  semester       Semester?         @relation(fields: [semesterId], references: [id])
  regulation     Regulation?       @relation(fields: [regulationId], references: [id])
  units          Unit[]
  syllabi        Syllabus[]
  notes          Note[]
  questionPapers QuestionPaper[]
  userSubjects   UserSubject[]
  exams          Exam[]
  createdAt      DateTime          @default(now())

  @@index([departmentId])
  @@index([semesterId])
  @@index([regulationId])
}

model UserSubject {
  id        String    @id @default(cuid())
  userId    String
  subjectId String
  user      User      @relation(fields: [userId], references: [id])
  subject   Subject   @relation(fields: [subjectId], references: [id])
  createdAt DateTime  @default(now())

  @@unique([userId, subjectId])
}

model Unit {
  id        String  @id @default(cuid())
  name      String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  topics    Topic[]

  @@index([subjectId])
}

model Topic {
  id                    String            @id @default(cuid())
  name                  String
  description           String?
  unitId                String?
  subjectId             String?
  importanceScore       Float?            @default(0)
  questionFrequency     Int?              @default(0)
  marksDistributionJson Json?
  unit                  Unit?             @relation(fields: [unitId], references: [id])
  questionTopics        QuestionTopic[]
  progress             TopicProgress[]

  @@index([unitId])
  @@index([subjectId])
}

model Syllabus {
  id          String   @id @default(cuid())
  subjectId   String
  title       String?
  content     String
  unitName    String?
  sourceUrl   String?
  sourceType  String?  @default("LOCAL")
  lastSynced  DateTime @default(now())
  subject     Subject  @relation(fields: [subjectId], references: [id])
}

model Note {
  id          String   @id @default(cuid())
  subjectId   String
  unitName    String?
  title       String
  content     String
  sourceUrl   String?
  sourceType  String?  @default("LOCAL")
  lastSynced  DateTime @default(now())
  subject     Subject  @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
}

model QuestionPaper {
  id          String     @id @default(cuid())
  externalId  String?    @unique
  userId      String?
  subjectId   String
  year        Int
  examType    String
  semester    String?
  title       String
  sourceUrl   String?
  fileUrl     String?
  metadata    Json?
  user        User?      @relation(fields: [userId], references: [id])
  subject     Subject    @relation(fields: [subjectId], references: [id])
  questions   Question[]
  createdAt   DateTime   @default(now())

  @@index([subjectId])
  @@index([userId])
  @@index([year])
  @@index([examType])
}

model Question {
  id               String         @id @default(cuid())
  questionPaperId  String
  questionPaper    QuestionPaper  @relation(fields: [questionPaperId], references: [id])
  text             String
  marks            Int?
  normalizedText   String?
  similarityLabel  String?
  topicTags        String[]
  createdAt        DateTime       @default(now())
  questionTopics   QuestionTopic[]

  @@index([questionPaperId])
}

model QuestionTopic {
  id          String   @id @default(cuid())
  topicId     String
  questionId  String
  similarity  Float?
  marks       Int?
  topic       Topic    @relation(fields: [topicId], references: [id])
  question    Question @relation(fields: [questionId], references: [id])

  @@unique([topicId, questionId])
}

model Exam {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String?
  title      String
  examDate   DateTime
  status     String   @default("upcoming")
  user       User     @relation(fields: [userId], references: [id])
  subject    Subject? @relation(fields: [subjectId], references: [id])
}

model StudyPlan {
  id             String          @id @default(cuid())
  userId         String
  title          String
  generatedAt    DateTime        @default(now())
  examDate       DateTime?
  status         String          @default("active")
  user           User            @relation(fields: [userId], references: [id])
  days           StudyPlanDay[]
  tasks          StudyTask[]
}

model StudyPlanDay {
  id         String      @id @default(cuid())
  studyPlanId String
  dayIndex   Int
  title      String
  summary    String?
  studyPlan  StudyPlan   @relation(fields: [studyPlanId], references: [id])

  @@index([studyPlanId])
}

model StudyTask {
  id           String     @id @default(cuid())
  studyPlanId  String
  title        String
  description  String?
  completed    Boolean    @default(false)
  status       String     @default("pending")
  durationMinutes Int?
  subjectName  String?
  topicName    String?
  scheduledAt  DateTime?
  taskType     String?
  priority     Int?       @default(1)
  studyPlan    StudyPlan  @relation(fields: [studyPlanId], references: [id])

  @@index([studyPlanId])
}

model Quiz {
  id             String         @id @default(cuid())
  userId         String?
  subjectId      String?
  title          String
  generatedAt    DateTime       @default(now())
  questions      QuizQuestion[]
  attempts       QuizAttempt[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  question    String
  options     Json
  correctAnswer String
  explanation String?
  topic       String?
  difficulty  String?
  marks       Int?
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  total       Int
  accuracy    Float?
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model TopicProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  completed   Boolean  @default(false)
  mastery     Float    @default(0)
  lastStudied DateTime?
  user        User     @relation(fields: [userId], references: [id])
  topic       Topic    @relation(fields: [topicId], references: [id])

  @@unique([userId, topicId])
}

model SyncLog {
  id          String   @id @default(cuid())
  source      String
  status      String
  lastSynced  DateTime @default(now())
  details     Json?
}

model AIAnalysis {
  id          String   @id @default(cuid())
  userId      String?
  subjectId   String?
  type        String
  inputHash   String?
  payload     Json
  createdAt   DateTime @default(now())
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, resourceType, resourceId])
  @@index([resourceType, resourceId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
